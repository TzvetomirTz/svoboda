{
  "expo": {
    "name": "Svoboda",
    "slug": "svoboda",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "svoboda",
    "userInterfaceStyle": "light",
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
