{
  "expo": {
    "name": "Svoboda",
    "slug": "svoboda",
    "version": "1.0.9",
    "orientation": "portrait",
    "scheme": "svoboda",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Svoboda uses Face ID to unlock, so only you can open your messages."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Svoboda uses the camera to scan the other person's contact code.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 225,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0A0A0A"
          },
          "android": {
            "imageWidth": 180
          }
        }
      ],
      "expo-status-bar",
      "./plugins/with-refuse-third-party-keyboards",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "icon": "./assets/images/icon.png",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "com.oblivionware.svoboda"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-foreground.png",
        "monochromeImage": "./assets/images/android-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.oblivionware.svoboda",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "174dcf75-00d5-47b2-bd1e-a8cb1947f8db"
      }
    },
    "owner": "oblivionware"
  }
}
